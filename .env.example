# Copy to .env.local and fill in. Never commit real values.

# Where YAML records live. MUST be a persistent disk in production (see docs/adr/0001).
DATA_DIR=./data
# Set to true only for throwaway demos on serverless hosts.
ALLOW_EPHEMERAL_DATA_DIR=false

# Admin login. Generate the hash with:  npm run hash-password -- "your-password"
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD_HASH=

# 32+ random characters, used to sign session cookies.
SESSION_SECRET=
SESSION_TTL_MINUTES=120

# Email: "outbox" writes .eml files to DATA_DIR/outbox (development); "smtp" sends for real.
EMAIL_PROVIDER=outbox
EMAIL_FROM="RTS Office <rts@example.edu>"
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Shared secret used to verify delivery/bounce webhooks (HMAC-SHA256 of the raw body).
EMAIL_WEBHOOK_SECRET=

# Public base URL used in email links.
APP_BASE_URL=http://localhost:3000

# Dev only: extra hosts allowed to use the dev server, e.g. your LAN IP (comma-separated)
DEV_ALLOWED_ORIGINS=
